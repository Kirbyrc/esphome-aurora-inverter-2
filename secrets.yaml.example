# Secrets used by example_inverter.yaml. Add these to the secrets.yaml in
# your ESPHome config directory and replace the placeholder values.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot (at least 8 characters).
recovery_password: "change-me-please"

# 32-byte base64 key, also used to encrypt OTA uploads; generate one at
# https://esphome.io/components/api/
ha_encryption_key: "REPLACE_WITH_BASE64_KEY"

web_server_username: "admin"
web_server_password: "change-me"
